rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow get: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.get('email', '').lower() == 'jhonny.spider@gmail.com';
    }

    function isServerAuthorizedCeo() {
      return isSignedIn() && request.auth.token.get('email_verified', false) == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/access_admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/access_admins/$(request.auth.uid)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/access_admins/$(request.auth.uid)).data.role == 'ceo'
        && get(/databases/$(database)/documents/access_admins/$(request.auth.uid)).data.enabled == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches("^[a-zA-Z0-9_-]+$");
    }

    function isValidUser(data) {
      return data.get('displayName', '') is string && data.get('displayName', '').size() <= 200
        && data.get('email', '') is string && data.get('email', '').size() <= 200
        && !data.keys().hasAny(['password', 'passwordHash']);
    }

    function isValidSession(data) {
      return data.get('id', '') is string
        && data.get('title', '') is string && data.get('title', '').size() <= 500
        && data.get('userId', request.auth.uid) == request.auth.uid
        && (data.get('guidedSubject', null) == null || data.get('guidedSubject', '') is string)
        && (data.get('messages', []) is list)
        && (data.get('lastUpdatedAt', 0) is number)
        && (data.get('reviews', []) is list)
        && (data.get('currentArticle', 1) is number)
        && (data.get('trilhaDay', null) == null || data.get('trilhaDay', 0) is number)
        && (data.get('trilhaMaterialIndex', null) == null || data.get('trilhaMaterialIndex', 0) is number)
        && (data.get('trilhaSessionType', null) == null || data.get('trilhaSessionType', '') is string);
    }
    
    function isValidStat(data) {
      return data.get('userId', '') == request.auth.uid
        && data.get('subjectName', '') is string;
    }

    function isValidFailedQuestion(data) {
      return data.get('userId', '') == request.auth.uid
        && data.get('text', '') is string;
    }

    function isValidSchedule(data) {
      return data.get('userId', '') == request.auth.uid
        && data.get('title', '') is string && data.get('title', '').size() <= 500
        && data.get('raioX', []) is list && data.get('cronograma', []) is list;
    }

    function isValidGamification(data) {
      return data.get('totalXP', 0) is number
        && data.get('level', 1) is number
        && data.get('streak', 0) is number;
    }

    function isValidTrilhaProgress(data) {
      return data.get('completedDays', []) is list
        && data.get('completedDays', []).size() <= 200;
    }

    match /auth_secrets/{userId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming())
        && !incoming().keys().hasAny(['role', 'isAdmin', 'admin', 'isCEO', 'permissions', 'customClaims']);
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().email == existing().email
        && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'isAdmin', 'admin', 'isCEO', 'permissions', 'customClaims']);
      
      match /gamification/{statusId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidId(statusId) && isValidGamification(incoming());
      }
      
      match /sessions/{sessionId} {
        allow list, get: if isServerAuthorizedCeo();
        allow create, update: if isServerAuthorizedCeo() && isOwner(userId) && isValidId(sessionId) && isValidSession(incoming());
        allow delete: if isOwner(userId);
      }

      match /stats/{subjectId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidId(subjectId) && isValidStat(incoming());
      }

      match /failed_questions/{questionId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create, delete: if isOwner(userId) && isValidId(questionId) && isValidFailedQuestion(incoming());
      }

      match /schedules/{scheduleId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidId(scheduleId) && isValidSchedule(incoming());
        allow delete: if isOwner(userId);
      }

      match /trilha/{trilhaId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create, update: if isServerAuthorizedCeo() && isOwner(userId) && isValidId(trilhaId) && isValidTrilhaProgress(incoming());
      }
    }

    function isCeoPublisher() {
      return incoming().get('approvedBy', '') is string
        && incoming().get('approvedBy', '').lower() == 'jhonny.spider@gmail.com';
    }

    function isValidHomologatedLesson(lessonId) {
      return lessonId.matches('^day_[0-9]{1,3}_part_[0-9]{1,2}$')
        && incoming().get('id', '') == lessonId
        && incoming().get('day', 0) is int
        && incoming().get('day', 0) >= 1
        && incoming().get('day', 0) <= 100
        && incoming().get('part', -1) is int
        && incoming().get('part', -1) >= 0
        && incoming().get('part', -1) <= 20
        && incoming().get('content', '') is string
        && incoming().get('content', '').size() >= 20
        && incoming().get('content', '').size() <= 900000
        && incoming().get('status', '') == 'approved'
        && incoming().get('subject', '') is string
        && incoming().get('subject', '').size() <= 200
        && isCeoPublisher();
    }

    match /homologated_lessons/{lessonId} {
      allow read: if isServerAuthorizedCeo();
      // Only the existing authenticated CEO server transaction may publish.
      allow create, update: if false;
      allow delete: if false;
    }

    function isValidOfficialPart(partId) {
      return partId.matches('^day_[0-9]{1,3}_part_[0-9]{1,2}$')
        && incoming().get('id', '') == partId
        && incoming().get('day', 0) is int
        && incoming().get('day', 0) >= 1
        && incoming().get('day', 0) <= 100
        && incoming().get('part', -1) is int
        && incoming().get('part', -1) >= 0
        && incoming().get('part', -1) <= 20
        && incoming().get('subject', '') is string
        && incoming().get('subject', '').size() <= 200
        && incoming().get('status', '') == 'approved'
        && incoming().get('review', '') is string
        && incoming().get('review', '').size() <= 20000
        && isCeoPublisher();
    }

    match /homologated_parts/{partId} {
      allow read: if isServerAuthorizedCeo();
      // Blocks stale browser bundles as well as the new client.
      allow create, update: if false;
      allow delete: if false;
    }

    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /legal_reviews/{reviewId} {
      allow read, write: if false;
    }

    match /legal_review_index/{lessonId} {
      allow read, write: if false;
    }
  }
}

