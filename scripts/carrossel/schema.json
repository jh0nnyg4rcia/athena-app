{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AthenaCarouselContract",
  "version": "1.0.0",
  "type": "object",
  "required": ["meta", "slides"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schema_version",
        "editorial_id",
        "data_boletim",
        "disciplina",
        "carreiras",
        "tema",
        "origem",
        "estado_editorial",
        "fontes_oficiais_verificadas",
        "pontos_pendentes"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": ["1.0.0"]
        },
        "editorial_id": {
          "type": "string",
          "pattern": "^ATHENA-BOL-[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Za-z0-9_-]+$"
        },
        "data_boletim": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "disciplina": {
          "type": "string",
          "enum": [
            "Direito Constitucional",
            "Direito Administrativo",
            "Direito Penal",
            "Direito Processual Penal",
            "Direito Civil",
            "Direito Processual Civil",
            "Direito Tributário",
            "Direito Empresarial",
            "Direito Ambiental",
            "Direitos Humanos",
            "Direito Financeiro",
            "Direito Eleitoral",
            "Direito da Criança e do Adolescente",
            "Direito Coletivo / Difuso"
          ]
        },
        "carreiras": {
          "type": "string",
          "minLength": 3
        },
        "tema": {
          "type": "string",
          "minLength": 5,
          "maxLength": 140
        },
        "origem": {
          "type": "object",
          "required": ["sistema", "gerador", "curadoria"],
          "additionalProperties": false,
          "properties": {
            "sistema": { "type": "string" },
            "gerador": { "type": "string" },
            "curadoria": { "type": "string" }
          }
        },
        "estado_editorial": {
          "type": "string",
          "enum": [
            "DRAFT",
            "LEGAL_REVIEW",
            "LEGAL_APPROVED",
            "ART_GENERATED",
            "VISUAL_APPROVED",
            "READY_FOR_MANUAL_PUBLICATION"
          ]
        },
        "fontes_oficiais_verificadas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tipo", "referencia", "link_oficial", "auditado"],
            "additionalProperties": false,
            "properties": {
              "tipo": {
                "type": "string",
                "enum": ["constituicao", "lei", "sumula", "tema_repercussao_geral", "jurisprudencia", "doutrina"]
              },
              "referencia": { "type": "string", "minLength": 3 },
              "link_oficial": { "type": "string", "format": "uri" },
              "auditado": { "type": "boolean" }
            }
          }
        },
        "pontos_pendentes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["numero", "tipo", "titulo"],
        "properties": {
          "numero": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "tipo": {
            "type": "string",
            "enum": [
              "capa",
              "lei_seca",
              "jurisprudencia",
              "excecao_pegadinha",
              "questao",
              "gabarito",
              "revisao"
            ]
          },
          "titulo": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    }
  }
}
