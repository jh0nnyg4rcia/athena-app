# Copie para .env.local (ou .env). Nunca commite credenciais reais.
# Não use prefixo VITE_ em segredos: variáveis VITE_* entram no bundle do cliente/APK.

# Obrigatório no Express (proxy Gemini). Somente servidor.
GEMINI_API_KEY=

# Porta do proxy (opcional; padrão 3000)
PORT=3000

# URL absoluta HTTPS do proxy para o app Capacitor / APK.
# Em `npm run dev` deixe vazio para usar rotas relativas (/api/*) no mesmo origin.
# Produção (Cloud Function): https://southamerica-east1-gen-lang-client-0822763072.cloudfunctions.net/athenaApi
# O APK também usa este valor como fallback nativo se VITE_API_URL estiver vazio.
VITE_API_URL=

# Origem CORS do proxy. Use * só em desenvolvimento.
# Produção: https://athena-mentoria.web.app (e a origin do WebView Capacitor, se distinta)
CORS_ORIGIN=*

# Auth do proxy: false = sem Bearer; omitido = Bearer opcional (token inválido ainda é 401);
# strict = Bearer Firebase obrigatório. Login por código não tem token — não use strict em produção do APK.
REQUIRE_API_AUTH=false

# Opcional: chave web do Firebase só para validar ID tokens no servidor.
# Se vazia, o servidor usa firebase-applet-config.json (identificador de cliente, não a chave Gemini).
FIREBASE_WEB_API_KEY=

# Assinatura Android (preferir android/keystore.properties, não versionado)
# ATHENA_STORE_FILE=android/app/athena.keystore
# ATHENA_STORE_PASSWORD=
# ATHENA_KEY_ALIAS=athena
# ATHENA_KEY_PASSWORD=
